+[
+  {
+    "room": "town-gate",
+    "id": "TG-01",
+    "title": "Read the Crossing Signal",
+    "kind": "puzzle",
+    "optional": false,
+    "goal": "Find when the crossing is safe.",
+    "firstImpression": "A trolley waits behind a stop bar; the gate lamp has a moving mechanical shutter.",
+    "controls": [
+      "shelter: select the recessed viewpoint",
+      "cycle-drum: turn one notch to replay a slow demonstration",
+      "crossing-marker: select the safe phase"
+    ],
+    "clues": [
+      "The trolley remains stopped during two bell strokes and moves only when the lamp shutter closes.",
+      "A two-notch drum and a walking trolley symbol mirror the sounds; darkness alone is not the clue."
+    ],
+    "steps": [
+      "Enter the stone recess; the demonstration cannot harm Mara.",
+      "Replay the cycle; notch one and notch two rise with the two bells.",
+      "Select the walking-trolley symbol after notch two, while the lamp shutter is closed.",
+      "The safe phase stays pinned on the drum beside the exit."
+    ],
+    "wrong": "Selecting an earlier phase leaves the stop bar down; replay remains available.",
+    "hints": [
+      "Watch the trolley rather than the distant silhouette.",
+      "Count the two raised notches.",
+      "Choose the walking symbol after the second notch."
+    ],
+    "completion": "The player identifies the safe phase after seeing or stepping through one complete cycle.",
+    "status": "specified-not-implemented"
+  },
+  {
+    "room": "town-gate",
+    "id": "TG-02",
+    "title": "Release the Gate Latch",
+    "kind": "puzzle",
+    "optional": false,
+    "goal": "Open the gate without supplying a living name.",
+    "firstImpression": "Named badges make a test striker speak; the blank badge advances an unvoiced latch tooth.",
+    "controls": [
+      "badge-slot: select or place the blank badge",
+      "tension-handle: pull to the marked stop",
+      "catch: lift while the handle is latched"
+    ],
+    "clues": [
+      "A cutaway test track shows named badges trapped under a speaking-mouth jaw.",
+      "The blank badge passes under that jaw and bears the same notch as the intake-key drawer."
+    ],
+    "steps": [
+      "Slide the blank badge through the cutaway; the mouth jaw stays closed.",
+      "Seat that badge in the real slot; a latch tooth withdraws.",
+      "Pull the tension handle to its physical stop, then lift the catch.",
+      "The gate unlocks and the drawer dispenses the existing intake key once."
+    ],
+    "wrong": "A named badge springs back before transmission; a loaded catch cannot lift. No identity is committed by an exploratory click.",
+    "hints": [
+      "Watch which badge bypasses the mouth jaw.",
+      "The empty badge is an intentional entry.",
+      "Blank badge, pull handle, lift catch."
+    ],
+    "completion": "Blank entry selected, latch released and intake key granted once; crossing remains subject to TG-01.",
+    "status": "specified-not-implemented"
+  },
+  {
+    "room": "town-gate",
+    "id": "TG-03",
+    "title": "Answer the Callbox",
+    "kind": "investigation",
+    "optional": true,
+    "goal": "Check whether the apparent voice is a live person.",
+    "firstImpression": "A spool behind the callbox moves even while its microphone cover is closed.",
+    "controls": [
+      "microphone-cover: close or open without speaking",
+      "spool-window: examine",
+      "return-arrows: trace with cursor or focus"
+    ],
+    "clues": [
+      "The same hesitation repeats at the same spool mark.",
+      "Arrows in the shelter point toward a maintenance passage and back to the road."
+    ],
+    "steps": [
+      "Close the microphone cover and replay the recorded query.",
+      "Compare the spool mark with the repeated hesitation; the voice repeats unchanged.",
+      "Trace the carved return arrow to record the existing maintenance route."
+    ],
+    "wrong": "Opening the cover does not force Mara to speak; closing it always cancels the interaction.",
+    "hints": [
+      "Watch the spool mark.",
+      "A reply continues with the microphone covered.",
+      "Record the maintenance arrows from shelter."
+    ],
+    "completion": "Optional route marks recorded; no required gate clue is exclusive to this encounter.",
+    "status": "specified-not-implemented"
+  },
+  {
+    "room": "visitor-centre",
+    "id": "VC-01",
+    "title": "Restore the Map Circuit",
+    "kind": "puzzle",
+    "optional": false,
+    "goal": "Power the isolated map transformer.",
+    "firstImpression": "Three low-voltage toggles have circle, triangle and square plates; the map is dark.",
+    "controls": [
+      "circle-isolator: disconnect",
+      "triangle-feed: connect",
+      "square-feed: connect"
+    ],
+    "clues": [
+      "A transparent diagram exposes the feed from circle through triangle to square.",
+      "Red/circle, blue/triangle and amber/square labels retain the existing order without color-only dependence."
+    ],
+    "steps": [
+      "Examine the transparent diagram and isolate the circle toggle.",
+      "Connect the triangle feed; the first route segment illuminates.",
+      "Connect the square feed; the map lights and its breaker remains closed."
+    ],
+    "wrong": "Wrong order trips a resettable map-only breaker; no fuse or inventory item is consumed.",
+    "hints": [
+      "Follow the physical feed line.",
+      "Isolate the circle before joining the two feeds.",
+      "Circle off, triangle on, square on."
+    ],
+    "completion": "All three toggles match the isolated, connected, connected configuration.",
+    "status": "specified-not-implemented"
+  },
+  {
+    "room": "visitor-centre",
+    "id": "VC-02",
+    "title": "Release the District Key",
+    "kind": "puzzle",
+    "optional": false,
+    "goal": "Expose the café route using the intake key already obtained.",
+    "firstImpression": "The cabinet lock matches the blank reverse of Mara’s intake key; the café route is hidden behind an overlay.",
+    "controls": [
+      "intake-lock: use key without consuming it",
+      "map-overlay: slide or select layer",
+      "wave-marker: align with café window"
+    ],
+    "clues": [
+      "The visitor book has Elian’s wave beside CAFÉ 07:10; this short identification remains readable.",
+      "The same wave is stamped into the map slider’s café stop."
+    ],
+    "steps": [
+      "Use the existing intake key to open the map overlay cabinet.",
+      "Slide the wave marker to the café stop; a sightline opens toward the café street.",
+      "Select either the front street or staff-route preview, without committing departure yet."
+    ],
+    "wrong": "The wrong overlay shows a visibly boarded exit; return the slider freely.",
+    "hints": [
+      "Find the wave in Elian’s entry.",
+      "The key unlocks a map layer, not a new inventory item.",
+      "Align the wave with the café."
+    ],
+    "completion": "Café lead recorded and a usable route displayed; no second district-key item is created.",
+    "status": "specified-not-implemented"
+  },
+  {
+    "room": "visitor-centre",
+    "id": "VC-03",
+    "title": "Find the Altered Route",
+    "kind": "investigation",
+    "optional": true,
+    "goal": "Compare the official evacuation with its earlier copy.",
+    "firstImpression": "A carbon layer protrudes beneath the visitor register.",
+    "controls": [
+      "carbon-tab: lift",
+      "map-layer: compare staff and public routes",
+      "camera-mark: record pair"
+    ],
+    "clues": [
+      "Matching punched holes align the two sheets.",
+      "The same entries move from DEPARTED to RETAINED; neither sheet supplies a new person to follow."
+    ],
+    "steps": [
+      "Lift the carbon tab and align both sheets by their punched holes.",
+      "Toggle the staff layer; its route joins the same café.",
+      "Record both sheets together as evidence of selective evacuation."
+    ],
+    "wrong": "Misalignment leaves registration holes visibly offset; rotate back without losing evidence.",
+    "hints": [
+      "Match the punched holes.",
+      "Compare the two status stamps for the same entries.",
+      "Record both layers together."
+    ],
+    "completion": "Optional selective-evacuation evidence retained; front and staff routes still converge.",
+    "status": "specified-not-implemented"
+  },
+  {
+    "room": "closed-cafe",
+    "id": "CF-01",
+    "title": "Tune the Witness Transmission",
+    "kind": "puzzle",
+    "optional": false,
+    "goal": "Find the broadcast that matches Elian’s original cassette.",
+    "firstImpression": "The cassette waveform has one gull peak followed by two bell peaks.",
+    "controls": [
+      "cassette: replay",
+      "radio-dial: turn among 81, 94 and 107 detents",
+      "compare-switch: alternate source and broadcast"
+    ],
+    "clues": [
