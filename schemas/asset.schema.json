{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "kind", "source"],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "const": "procedural-scene"
      },
      "source": {
        "type": "object",
        "required": ["kind", "data"],
        "properties": {
          "kind": {
            "const": "inline"
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  }
}
