{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "acts", "locations"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "acts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "locations": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
