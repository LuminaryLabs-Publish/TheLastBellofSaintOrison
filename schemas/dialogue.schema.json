{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["arrival", "lines"],
  "properties": {
    "arrival": {
      "type": "string",
      "minLength": 1
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "speaker", "text"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
