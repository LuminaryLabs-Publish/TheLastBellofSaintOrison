{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "kind"],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "kind": {
        "enum": [
          "clue",
          "puzzle",
          "collect",
          "inspect",
          "use",
          "dialogue",
          "optional"
        ]
      }
    }
  }
}
