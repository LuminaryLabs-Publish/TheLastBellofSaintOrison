{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "question",
      "options",
      "answer",
      "success",
      "wrong",
      "hints"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "question": {
        "type": "string",
        "minLength": 1
      },
      "options": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "answer": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "success": {
        "type": "string",
        "minLength": 1
      },
      "wrong": {
        "type": "string",
        "minLength": 1
      },
      "hints": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
