{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "kind", "version", "status", "requires", "provides"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": ["domain", "service", "location", "composition"]
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["implemented", "scaffold"]
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
