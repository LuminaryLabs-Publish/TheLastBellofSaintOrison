{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "name", "goal", "act", "minutes"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "act": {
      "type": "integer",
      "minimum": 0
    },
    "minutes": {
      "type": "number",
      "minimum": 0
    }
  }
}
