{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "goal", "required", "puzzleId"],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "goal": {
        "type": "string",
        "minLength": 1
      },
      "required": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "puzzleId": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
